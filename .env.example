# Copie para .env antes de usar o Docker Compose:
#   cp .env.example .env
# Nunca comite o .env nem use senhas reais neste arquivo.

# Modo do banco: sqlite (padrão, zero configuração) ou postgres.
JLS_MODE=sqlite

# Caminho do arquivo SQLite dentro do container/servidor.
JLS_DB_PATH=/app/data/jurislab.sqlite3

# Semear tribunais e decisões fictícias na primeira execução.
JLS_SEED=1

# Segredos: troque obrigatoriamente em produção.
JLS_JWT_SECRET=dev-only-jurislab-change-me-in-production
JLS_ADMIN_PASSWORD=admin

# Origens CORS separadas por vírgula (vazio = mesma origem).
JLS_CORS_ORIGINS=

# Limite de tentativas de token por IP e janela em segundos.
JLS_RATE_LIMIT=10
JLS_RATE_WINDOW=60

# Senha do usuário `juris` no PostgreSQL do perfil `postgres`.
DB_PASSWORD=juris_dev

# URL usada pela API/importador quando JLS_MODE=postgres.
# Dentro do Compose o host é `db`; fora dele use `localhost`.
DATABASE_URL=postgresql://juris:juris_dev@db:5432/jurisprudencia

# Onde o FastAPI encontra index.html, css/ e js/.
FRONTEND_DIR=/app/frontend

# Nível de log da aplicação (debug, info, warning, error; padrão: info).
LOG_LEVEL=info

# Teto da contagem de resultados e do exportador, respectivamente.
LIMITE_CONTAGEM=10000
JLS_EXPORT_MAX=1000

# Confie em X-Forwarded-For para o limite de tentativas (0 = IP direto).
JLS_TRUST_PROXY=0

# Inclui X-Request-ID nas respostas (0 = desligado).
JLS_REQUEST_ID=0

# Autoriza segredos de desenvolvimento em demonstrações e testes (0 = recusa).
JLS_ALLOW_DEFAULT_SECRETS=0
