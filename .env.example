# Copie este arquivo para .env antes de subir o projeto:
#   cp .env.example .env
# Nunca comite o .env nem use senhas reais neste arquivo.

# Senha do usuario `juris` no PostgreSQL do Docker Compose (valor de desenvolvimento).
DB_PASSWORD=juris_dev

# String de conexao usada pela API e pelo importador.
# Dentro do Compose o host é `db`; fora dele (execucao local) use `localhost`.
DATABASE_URL=postgresql://juris:juris_dev@db:5432/jurisprudencia

# Onde o FastAPI encontra index.html, css/ e js/ (valor usado dentro do container).
FRONTEND_DIR=/app/frontend

# Nivel de log da aplicacao (debug, info, warning, error).
LOG_LEVEL=info
